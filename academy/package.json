{
  "name": "alaeinasab-academy",
  "version": "2.0.0",
  "private": true,
  "description": "پلتفرم فروش دوره آکادمی ریاضی استاد علایی‌نسب (فرانت React + بک‌اند Node.js + PostgreSQL)",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "node web/build.mjs",
    "dev": "node web/build.mjs --watch & node --watch server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed:dev": "node server/db/seed-dev.js",
    "create-admin": "node server/scripts/create-admin.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.460.0",
    "playwright": "^1.50.0"
  }
}
